game.mode=training
game.burlapConfig=src/test/resources/configurations/burlap_test.config
game.lrSingleAgent=true
game.lrSingleAgentSutConfig=src/test/resources/configurations/lrLevelSingleAgent.config
game.lrMultiAgentSutConfig=src/test/resources/configurations/lrLevelMultiAgent.config

game.mineAgentSutConfig=src/test/resources/configurations/mineAgent.config
# BURLAP parameters for Minecraft (episodes, epsilon, gamma, lr). Kept apart from
# game.burlapConfig, which is LabRecruits', so that tuning one SUT does not
# silently retune the other. If absent, game.burlapConfig is used as a fallback.
game.mineAgentBurlapConfig=src/test/resources/configurations/burlap_minecraft.config
# true = run the scripted baseline (MineAgentBaseline), false = run the RL agent
game.mineAgentUseBaseline=false
