# BURLAP parameters for the Minecraft SUT.
#
# Separate from burlap_test.config on purpose: the two SUTs have different state
# spaces and episode costs, so sharing one file would mean every LabRecruits
# tweak silently retunes Minecraft (and the other way round).
#
# Only keys already declared in BurlapConfiguration are accepted: an unknown one
# makes updateParameters print "Burlap parameter ... not recognized" and stop.

burlap.algorithm=QLearning

# Smoke-run value. Three episodes is a smoke test, not an experiment: with a
# decay computed over 3 the exploration schedule means nothing, and the point is
# only to see the three actions fire and two resets complete. Raise to 50 once
# the run works and the cost of a reset is known to be affordable.
burlap.num_of_episodes=3

burlap.qlearning.qinit=0.1
burlap.qlearning.lr=0.25
burlap.qlearning.gamma=0.59
burlap.qlearning.epsilonval=0.5

# Recomputed from num_of_episodes at run time by MineAgent, this is only a seed.
burlap.qlearning.decayedepsilonstep=0.95
